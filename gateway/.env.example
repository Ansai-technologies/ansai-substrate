# Copy to .env and fill in. NEVER commit .env.
# Keys live in the vault (custom.deepseek / custom.gemini) and are injected
# as environment variables at deploy time — never pasted into chat, never
# written to a file that gets committed.

DEEPSEEK_API_KEY=<paste-deepseek-key-here>
GEMINI_API_KEY=<paste-gemini-key-here>

# Gateway auth. Clients (agents, evals) send this as the Bearer token.
# Change from the default before any non-local exposure.
LITELLM_MASTER_KEY=sk-ansai-dev-local

# Postgres for spend tracking + virtual keys. REQUIRED — litellm refuses
# sqlite. docker compose provides it; on a VPS use Supabase Postgres.
DATABASE_URL=postgresql://litellm:litellm@localhost:5432/litellm

# Where agents find the gateway.
GATEWAY_URL=http://localhost:4000

# --- Agent tools (mcp/) ---
# GitHub access for agents. Create a fine-grained PAT at
# https://github.com/settings/tokens (read access to your repos; add
# issues:read/write only if you want agents filing issues) and paste it
# here. The model never sees this value — only tool results reach it.
GITHUB_TOKEN=<paste-github-pat-here>

# Local-machine sandbox for agent tools (mcp/local). Agents freely read/write
# under this root; anything outside it needs your approval. Shell commands
# always need approval except a small read-only allowlist. Defaults to the
# repo root when unset.
# AGENT_LOCAL_ROOT=C:\ansai-substrate
# AGENT_LOCAL_UNRESTRICTED=1   # opt-in: lift the sandbox (not recommended)
