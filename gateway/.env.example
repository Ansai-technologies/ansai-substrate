# Copy to .env and fill in. NEVER commit .env.
# Keys live in the vault (custom.deepseek / custom.gemini) and are injected
# as environment variables at deploy time — never pasted into chat, never
# written to a file that gets committed.

DEEPSEEK_API_KEY=<paste-deepseek-key-here>
GEMINI_API_KEY=<paste-gemini-key-here>

# Gateway auth. Clients (agents, evals) send this as the Bearer token.
# Change from the default before any non-local exposure.
LITELLM_MASTER_KEY=sk-ansai-dev-local

# Postgres for spend tracking + virtual keys. REQUIRED — litellm refuses
# sqlite. docker compose provides it; on a VPS use Supabase Postgres.
DATABASE_URL=postgresql://litellm:litellm@localhost:5432/litellm

# Where agents find the gateway.
GATEWAY_URL=http://localhost:4000
